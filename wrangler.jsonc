{
  // Cloudflare Workers：靜態資產（dist/）+ Worker script（/api/* → LiveShareRoom DO）。
  // D11 = B：GitHub Pages 仍然係主網址；呢個 Worker 提供 live share 嘅 /api/*，Pages 前端跨域 call。
  "name": "i-here",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "build": { "command": "npm run build" },
  // PR 分支嘅預覽部署用 `wrangler preview`，佢要求有 previews 區塊（可以係空嘅）；
  // assets / compatibility_date 仍然喺頂層，唔使重複。
  "previews": {},
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // 靜態資產照舊先服務；只有 /api/* 先入 Worker（live share 建房 + WebSocket upgrade）。
    "run_worker_first": ["/api/*"]
  },
  // 容許跨域 call /api/* 嘅 Origin（D11 = B：GitHub Pages 前端）。同源（Worker 自己）永遠放行。
  // 要加 preview / 自訂網域就逗號分隔，例：`https://iceninye.github.io,https://*.workers.dev`。
  "vars": { "ALLOWED_ORIGINS": "https://iceninye.github.io" },
  "durable_objects": {
    "bindings": [{ "name": "LIVE_SHARE", "class_name": "LiveShareRoom" }]
  },
  // 免費計劃只可以用 SQLite-backed DO → new_sqlite_classes（唔係 new_classes）。
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveShareRoom"] }]
}
