# 全部可選。複製成 .env.local 再填。

# Cloudflare Worker CORS 代理（見 worker/）。設定後所有政府 API 會經 `${VITE_API_PROXY}/<host>/<path>` 轉發。
# 例：VITE_API_PROXY=https://i-here-proxy.<you>.workers.dev
VITE_API_PROXY=

# 地政總署 3D 視覺化地圖（Tile-based models，3D Tiles 格式）tileset.json 完整網址（包括 key）。
# 留空 = 立體模式只用輕量建築物外廓擠出（fill-extrusion）。
VITE_LANDSD_3DTILES_URL=
